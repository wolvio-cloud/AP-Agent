# Database
# For Docker: use 'db' as hostname
# For local: use 'localhost' as hostname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clarity

# JWT
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Cloud Storage (Optional - uses local storage fallback if not configured)
GCS_BUCKET_NAME=clarityap-invoices
GOOGLE_APPLICATION_CREDENTIALS=

# GCS Encryption at Rest (Optional - for enhanced SOC 2 compliance)
# If not set, uses Google-managed encryption keys (still encrypted by default)
# Format: projects/PROJECT_ID/locations/LOCATION/keyRings/RING_NAME/cryptoKeys/KEY_NAME
# GCS_KMS_KEY_NAME=projects/my-project/locations/us/keyRings/clarityap/cryptoKeys/invoice-encryption

# Redis (Optional for MVP - not required for basic functionality)
REDIS_URL=redis://localhost:6379/0

# Gemini AI (Optional - uses mock extraction service if not configured)
GEMINI_API_KEY=

# App
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
